{
  "$schema": "../registry.schema.json",
  "id": "conservar",
  "name": "Conservar",
  "number": "03",
  "status": "draft",
  "inspiration": "Brand of Conservar Terceirização e Condomínios: official logo + palette sheet (references/marca-logo-paleta.jpg) and the @conservar_terceirizacao Instagram feed (bold white headlines on slate navy, key words in orange, orange swoosh).",
  "summary": "Corporate, reassuring brand style for Conservar videos: slate navy, one orange accent, heavy sans headlines, logo sign-off.",
  "palette": {
    "bg": "#43506A",
    "fg": "#FFFFFF",
    "accent": "#F07C26",
    "gray": "#C2C6CD",
    "notes": "The four official brand colors. Orange is the single accent. Mirrored in tokens.css."
  },
  "fonts": {
    "display": "Montserrat",
    "body": "Montserrat",
    "mono": "Montserrat",
    "notes": "Montserrat 800-900 approximates the feed's headline sans; replace if official fonts arrive. Never re-type the wordmark; use assets/logo-*.png."
  },
  "motion": "Confident and clean: power3.out slides and fades, orange highlight blocks wipe left to right, no spins or heavy bounces.",
  "transitions": "Slide + fade in, quick fade out; swoosh sweep on takeovers.",
  "cards": [
    {
      "id": "conservar.t1.thesis",
      "tier": "tier1",
      "purpose": "thesis",
      "file": "cards/tier1/t1-thesis.html",
      "slots": [
        { "name": "kicker", "type": "text", "maxChars": 28 },
        { "name": "headline", "type": "text", "maxChars": 32 },
        { "name": "highlight", "type": "text", "maxChars": 24 }
      ],
      "duration": { "min": 3, "max": 6 },
      "preview": { "mp4": "preview/conservar.t1.thesis.mp4", "poster": "preview/conservar.t1.thesis.png" }
    },
    {
      "id": "conservar.t1.stat",
      "tier": "tier1",
      "purpose": "stat",
      "file": "cards/tier1/t1-stat.html",
      "slots": [
        { "name": "kicker", "type": "text", "maxChars": 28 },
        { "name": "stat", "type": "text", "maxChars": 6 },
        { "name": "label", "type": "text", "maxChars": 56 }
      ],
      "duration": { "min": 4, "max": 7 },
      "preview": { "mp4": "preview/conservar.t1.stat.mp4", "poster": "preview/conservar.t1.stat.png" }
    },
    {
      "id": "conservar.t2.lower-third",
      "tier": "tier2",
      "purpose": "lower-third",
      "file": "cards/tier2/t2-lower-third.html",
      "slots": [
        { "name": "name", "type": "text", "maxChars": 28 },
        { "name": "role", "type": "text", "maxChars": 40 }
      ],
      "duration": { "min": 4, "max": 6 },
      "preview": { "mp4": "preview/conservar.t2.lower-third.mp4", "poster": "preview/conservar.t2.lower-third.png" }
    },
    {
      "id": "conservar.t2.list",
      "tier": "tier2",
      "purpose": "list",
      "file": "cards/tier2/t2-list.html",
      "slots": [
        { "name": "tag", "type": "text", "maxChars": 24 },
        { "name": "headline", "type": "text", "maxChars": 40 },
        { "name": "items", "type": "list", "maxItems": 4, "maxChars": 28 }
      ],
      "duration": { "min": 6, "max": 15 },
      "preview": { "mp4": "preview/conservar.t2.list.mp4", "poster": "preview/conservar.t2.list.png" }
    }
  ]
