# Copy this file to .env.local and fill in real values.
#
# Local development: run `supabase start` (needs Docker) and copy the
# values `supabase status` prints for API URL / anon key / service_role key.
#
# Hosted project: copy these from the Supabase dashboard →
# Project Settings → API.

# Safe to expose to the browser — every table it can reach is protected
# by Row Level Security (see supabase/migrations/*_rls.sql).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security entirely — never prefix this
# with NEXT_PUBLIC_, never import it from a Client Component, never log it.
SUPABASE_SERVICE_ROLE_KEY=
