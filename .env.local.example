# Copy this file to .env.local and fill in real values.
#
# Local development: run `supabase start` (needs Docker) and copy the
# values `supabase status` prints for API URL / anon key / service_role key.
#
# Hosted project: copy these from the Supabase dashboard →
# Project Settings → API.

# Safe to expose to the browser — every table it can reach is protected
# by Row Level Security (see supabase/migrations/*_rls.sql).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security entirely — never prefix this
# with NEXT_PUBLIC_, never import it from a Client Component, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Shared secret for the /api/cron/task-reminders route —
# Vercel sends it automatically as `Authorization: Bearer $CRON_SECRET`
# on requests it triggers once this is set as an env var in the project.
CRON_SECRET=

# Server-only. Used by src/lib/notifications/email-sender.ts to send task
# reminder e-mails via the Resend API. Required — reminders throw a clear
# error (and are never marked as sent) if this is left unset.
RESEND_API_KEY=

# Server-only. Required — the "From" address for reminder e-mails, must
# be on a domain verified in Resend (e.g. "FIDE ONE <notificacoes@notificacoes.fidecomunicacao.com>").
# No hardcoded fallback: throws a clear error if left unset, same as
# RESEND_API_KEY above.
RESEND_FROM_EMAIL=

# Optional. Public base URL used to build links inside reminder e-mails
# (e.g. https://fide-one-ten.vercel.app). Falls back to Vercel's own
# VERCEL_URL, then to the known production URL, if unset.
NEXT_PUBLIC_SITE_URL=
